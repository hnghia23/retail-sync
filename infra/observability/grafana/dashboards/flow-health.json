    {
      "type": "stat",
      "id": 2,
      "title": "Đối soát (audit)",
      "description": "Kết quả `simulator audit` gần nhất (--otlp / --watch). DIVERGED = sự cố nghiêm trọng nhất.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(audit_status)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "chưa chạy audit",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CONVERGED",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "CONVERGING",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "DIVERGED",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
