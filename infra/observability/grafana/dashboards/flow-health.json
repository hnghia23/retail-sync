    {
      "type": "timeseries",
      "id": 11,
      "title": "POST /sales p95",
      "description": "Instrumentation FastAPI (semconv HTTP ổn định). Đường đỏ: NFR-02 500 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
