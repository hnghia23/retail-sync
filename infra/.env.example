# retail-sync — mẫu biến môi trường cho infra/compose.yaml
# Copy thành infra/.env rồi điền giá trị thật. KHÔNG commit file .env.
#
# Quy ước: mọi secret PHẢI qua biến môi trường — không hardcode trong compose.yaml
# hay trong code (đúng lỗi v1 đã mắc, xem docs/09-v1-postmortem.md O1).

# ── Edge (cửa hàng) ──
EDGE_DB_USER=edge_app
EDGE_DB_PASSWORD=changeme-edge

# ── Central (trung tâm) ──
CENTRAL_DB_USER=central_app
CENTRAL_DB_PASSWORD=changeme-central
# Trần độ dài mọi transaction của Central API (giây) — docs/17 §4 bẫy 1.
DB_TRANSACTION_TIMEOUT_SECONDS=60

# ── Data platform ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio-at-least-8-chars
CLICKHOUSE_USER=dw
CLICKHOUSE_PASSWORD=changeme-clickhouse
AIRFLOW_DB_PASSWORD=changeme-airflow
# Airflow 3: khóa JWT CHUNG cho api-server/scheduler/dag-processor (Execution API). Thiếu hoặc
# khác nhau → task chết với "Signature verification failed". Sinh: openssl rand -hex 32
AIRFLOW_JWT_SECRET=changeme-dung-openssl-rand-hex-32

# ── Pipeline S4/S5 (packages/pipeline, docs/17) — khi chạy từ máy dev ──
# PIPELINE_PG_DSN=postgresql://central_app:<mật khẩu>@localhost:5434/central
# LAKE_ENDPOINT=localhost:9000          # host:port pipeline dùng để GHI
# LAKE_ACCESS_KEY=<MINIO_ROOT_USER>
# LAKE_SECRET_KEY=<MINIO_ROOT_PASSWORD>
# LAKE_URL_FOR_CLICKHOUSE=http://minio:9000   # URL ClickHouse dùng để ĐỌC (mạng compose)
# CLICKHOUSE_URL=http://localhost:8123
PIPELINE_WINDOW_SECONDS=3600
# Lịch DAG retail_pipeline (cron). Giờ khi test, ngày khi chạy thật (docs/06).
PIPELINE_SCHEDULE=5 * * * *
PIPELINE_SAFETY_LAG_SECONDS=30
# Bộ giám sát luồng (service flow-monitor, profile observability) — chu kỳ đo, docs/17 §6.
FLOW_MONITOR_INTERVAL_SECONDS=30
# Bảo trì trung tâm (service central-maintenance): partition point_ledger + đối soát INV-4.
MAINTENANCE_INTERVAL_SECONDS=3600
# Backup Postgres cửa hàng (sidecar edge-backup-*): RPO ≤ 24h, giữ 7 bản.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7

# ── Xác thực (Edge + Central API) ──
JWT_SECRET_KEY=changeme-dung-openssl-rand-hex-32
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Dữ liệu khách (shared/pii.py) ──
# Khóa HMAC băm SĐT. GIỐNG NHAU ở mọi cửa hàng và trung tâm; đổi sau khi có dữ liệu = mọi
# phone_hash cũ mất nghĩa (không tra, không dò trùng C03 được). Sinh: openssl rand -hex 32
PII_HASH_KEY=changeme-dev-pii-hash-key
# Mật khẩu cho nhân viên dựng sẵn (edge.ops.seed --employees / central.ops.seed --employees-for).
# Chỉ dùng cho dev + bộ giả lập — production nhân viên do trung tâm tạo (FR-C01).
SEED_EMPLOYEE_PASSWORD=

# ── Quy tắc nghiệp vụ (docs/05-data-model.md §5 — config, không hardcode) ──
PRICING_DISCOUNT_STACKING=additive          # additive | multiplicative
PRICING_ROUNDING=to_dong_last_line          # to_dong_last_line | per_line
PRICING_PROMOTION_APPLIES_AT=order_open     # order_open | order_close
RETURN_ALLOW_CROSS_STORE=false
RETURN_DEMOTE_TIER_ON_RETURN=false
RETURN_ALLOW_NEGATIVE_BALANCE=true

# ── Observability (ADR-009) ──
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0                 # 100% khi dev/test; giảm ở production

# ── Sync worker ──
SYNC_BATCH_SIZE=200
SYNC_POLL_INTERVAL_SECONDS=2
SYNC_BACKOFF_MAX_SECONDS=300
# Chỉ đếm số lần TRUNG TÂM từ chối sự kiện — mất mạng không bao giờ tính vào đây.
SYNC_MAX_ATTEMPTS_BEFORE_DEAD_LETTER=10
SYNC_REQUEST_TIMEOUT_SECONDS=10

# ── Khóa của cửa hàng này ở trung tâm (docs/13 §2) ──
# Cấp bằng:  make provision-store STORE_ID=store-001   (in khóa ra MỘT lần)
# Để trống thì sync worker từ chối khởi động.
CENTRAL_API_KEY=
